# Source me in your ~/.zshrc and I'll take care of the rest!

SCRIPT_DIR=${0:a:h} # This only works in zsh so don't go around using this in bash

# source aliases and funcs
source ${SCRIPT_DIR}/zsh_aliases
source ${SCRIPT_DIR}/zsh_funcs

# Set prompt
PS1='%B'
PS1=$PS1'($(echo -e "\u2388")$(kubectl config current-context) | $(kubectl config view --minify --output 'jsonpath={..namespace}'))'
PS1=$PS1' [$USER:$(pwd | rev | cut -d/ -f 1 | rev)] \$ '
PS1=$PS1'%b'

# oh-my-zsh stuff

export REPORTTIME=5 # Commands that take more than 5 seconds of CPU time will report their timing stats

# Add wisely, as too many plugins slow down shell startup.
plugins=(git macos zsh-autosuggestions kubectl)
source $ZSH/oh-my-zsh.sh

# autocomplete stuff
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#999999,bold,underline"
ZSH_AUTOSUGGEST_STRATEGY=(history)

# prime ssh agent with my key
APPLE_SSH_ADD_BEHAVIOR=openssh ssh-add ~/.ssh/id_ed25519

# Setup fzf
source <(fzf --zsh)

# goofy stuff
# requires cowsay
shuf -n1 ${0:a:h}/../greetings.txt | cowsay -f $(shuf -n1 -e alpaca blowfish bud-frogs bunny cheese cower cupcake default dragon dragon-and-cow elephant eyes fox kitty llama meow moofasa moose sheep small stegosaurus three-eyes turkey turtle tux)