}

# Basic tmux session management
ts() {
  local base="${PWD##*/}"; base="${base//[.:]/_}"

  local existing=""
  tmux has-session -t="$base" 2>/dev/null && existing="$base"

  local name="$base" n=1
  while tmux has-session -t="$name" 2>/dev/null; do
    name="${base}-${n}"; n=$((n + 1))
  done

  local sessions
  sessions=$(tmux ls -F '  #{session_name} (#{session_windows} window#{?session_attached,; already attached,})' 2>/dev/null)

  local header="Existing Sessions:"
  [[ -n "$sessions" ]] && header+=$'\n'"$sessions" || header+=$'\n  (none)'

  local header_height=$(echo ${header} | wc -l)

  local options="1) New Session (${name})"
  local attach_num=2
  if [[ -n "$existing" ]]; then
    options+=$'\n'"2) Reattach (${existing})"
    attach_num=3
  fi
  options+=$'\n'"${attach_num}) Attach Existing"

  local total_height=$((header_height + 5 + attach_num))

  local choice
  choice=$(printf '%s\n' "$options" \
    | fzf --prompt='choose: ' --no-info --border --layout=reverse-list \
          --preview="echo '$header'" \
          --preview-window="bottom:$(echo $header | wc -l)" \
          --height="$total_height") || return 1

  case "$choice" in
    "1)"*)
      tmux new -s "$name"
      ;;
    "2) Reattach"*)
      tmux attach -t "$existing"
      ;;
    *)
      tmux new-session -A -s bootstrap \; choose-tree -sZ
      ;;
  esac
}

drone-lint-args() {
  grep 'ADDITIONAL_ARGS' .drone.yml | awk -F: '{print $NF}'
}

loop() {
  LOOP_SECONDS=${LOOP_SECONDS:-2}

  while :
  do
    clear
    date
    echo "Every ${LOOP_SECONDS}s: ${@}\n"

    ${@}
    sleep ${LOOP_SECONDS}
  done
}

# CSV viewing

function pretty_csv {
    perl -pe 's/((?<=,)|(?<=^)),/---,/g;' "$@" | column -t -s,
}

function pretty_psv {
    perl -pe 's/((?<=\|)|(?<=^))\|/---\|/g;' "$@" | column -t -s\|
}

function pretty_tsv {
    perl -pe 's/((?<=\t)|(?<=^))\t/---\t/g;' "$@" | column -t -s $'\t'
}

# git helper functions
review() {( set -ex
  go fmt ./...
  go vet ./...
  go test ./...
  pgon go-lint "${@}"
)}

pr() {( set -e
  if [[ $(git branch --show-current) == "master" ]] then
    echo "I know you didn't mean to do this on master smh..."
    exit 1
  fi

  gpsu
  gh pr create --fill --web "${@}"
)}

release() {( set -e
  name=${1}
  if [[ -z ${name} ]]; then
    name="production-$(timestamp)"
  fi

  echo "Creating release tagged '${name}' in repo $(git config --get remote.origin.url)..."
  gh release create ${name} --target=master
)}

sibling-branch() {( set -e
  if [[ -z ${1} ]]; then
    echo "gimme a branch name idiot"
    exit 1
  fi

  set -x

  git stash save "creating sibling branch - $(date)"
  git checkout master
  git pull
  git checkout -b ${1}
  git stash pop
)}

new-branch() {( set -e
  if [[ -z ${1} ]]; then
    echo "gimme a branch name idiot"
    exit 1
  fi

  set -x

  git checkout master
  git pull
  git checkout -b ${1}
)}

